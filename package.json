{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4100",
    "generate-db-types": "npx supabase gen types --lang=typescript --project-id \"vivdcwiagunbifmahsbw\" > database.type.ts",
    "build": "next build",
    "start": "next start",
    "prepare": "husky",
    "clean": "rm -rf .next tsconfig.tsbuildinfo",
    "type-check": "tsc --noEmit",
    "fix": "eslint . --fix && prettier --write .",
    "lint": "eslint . && prettier --check . && tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "tsc-files --noEmit"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@ant-design/nextjs-registry": "1.3.0",
    "@supabase/ssr": "0.12.6",
    "@supabase/supabase-js": "2.115.0",
    "antd": "6.6.2",
    "dayjs": "1.11.23",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/web-push": "3.6.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "prettier": "3.9.6",
    "supabase": "2.116.0",
    "tsc-files": "1.1.4",
    "typescript": "6.0.3"
  }
}
